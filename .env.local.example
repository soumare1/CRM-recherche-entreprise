# Variables d'environnement — CRM Prospection
# Copiez ce fichier en .env.local et remplissez vos valeurs

# ── Supabase ─────────────────────────────────────────────────────────────────
# Trouvez ces valeurs dans : Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...votre_cle_anon...

# ── Mode de données ───────────────────────────────────────────────────────────
# "local"    → Données stockées dans le localStorage du navigateur (mode dev, pas de Supabase)
# "supabase" → Données persistées dans Supabase (mode production)
VITE_DATA_MODE=local
